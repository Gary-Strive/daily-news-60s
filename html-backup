
<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#7770db">
<title>每日60S · 今日简报</title>
<style>
:root {
  --purple: #7770db;
  --deep: #4e48a8;
  --coral: #ef665c;
  --ink: #29283b;
  --muted: #898797;
  --line: #eae8f3;
}
* { box-sizing: border-box; }

html {
  min-height: 100%;
  background: #eeedf5;
}
body {
  margin: 0;
  padding: 0;
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont,
    "PingFang SC", "Microsoft YaHei", sans-serif;
  -webkit-font-smoothing: antialiased;
}

.poster {
  position: relative;
  width: 100%;
  max-width: 720px;
  min-height: 100vh;
  margin: 0 auto;
  overflow: hidden;
  background: #fffefa;
  box-shadow: 0 8px 40px #33276612;
}

.hero {
  position: relative;
  overflow: hidden;
  padding: 29px 24px 27px;
  color: white;
  background: linear-gradient(140deg, #8c84ec 0%, #716bd4 48%, #514ba8 100%);
}

.hero::before,
.hero::after {
  position: absolute;
  content: "";
  border: 1px solid #ffffff24;
  border-radius: 50%;
  pointer-events: none;
}
.hero::before {
  width: 240px;
  height: 240px;
  right: -95px;
  top: -130px;
}
.hero::after {
  width: 180px;
  height: 180px;
  right: -65px;
  bottom: -125px;
}

.brand {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  font-size: 11px;
  letter-spacing: 2px;
  opacity: .96;
}

.brand-mark {
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 1px;
}

.hero-main {
  position: relative;
  z-index: 1;
  margin-top: 27px;
}

.weekday {
  margin: 0;
  font-size: clamp(43px, 12vw, 72px);
  font-weight: 900;
  line-height: 1.12;
  letter-spacing: 3px;
  overflow-wrap: anywhere;
}

.hero-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-top: 19px;
}

.hero-subtitle {
  font-size: 13px;
  letter-spacing: 1px;
}

.date-badge {
  flex-shrink: 0;
  padding: 6px 11px;
  border: 1px solid #ffffff6b;
  border-radius: 20px;
  font-size: 11px;
  letter-spacing: .5px;
}

.main {
  padding: 23px 22px 0;
}

.kicker {
  color: var(--muted);
  text-align: center;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 4px;
}

.title {
  margin: 3px 0 5px;
  color: var(--coral);
  text-align: center;
  font-size: 31px;
  line-height: 1.45;
  font-weight: 900;
  letter-spacing: 4px;
}

.subtitle {
  color: #92909d;
  text-align: center;
  font-size: 12px;
  letter-spacing: 2px;
}

.divider {
  display: flex;
  align-items: center;
  gap: 12px;
  margin: 19px 0 10px;
  color: #aaa7ba;
  font-size: 10px;
  letter-spacing: 2px;
}
.divider::before,
.divider::after {
  flex: 1;
  height: 1px;
  content: "";
  background: var(--line);
}

.news {
  margin: 0;
  padding: 0;
  list-style: none;
}

.news-item {
  display: grid;
  grid-template-columns: 31px minmax(0, 1fr);
  gap: 11px;
  padding: 14px 0;
  border-bottom: 1px solid var(--line);
}

.number {
  display: flex;
  width: 29px;
  height: 29px;
  align-items: center;
  justify-content: center;
  border-radius: 9px 9px 9px 3px;
  background: #eeecff;
  color: #625cc3;
  font-size: 13px;
  font-weight: 850;
}

.news-content {
  min-width: 0;
}

.news-text {
  margin: 0;
  font-size: 15px;
  line-height: 1.85;
  font-weight: 550;
  overflow-wrap: anywhere;
  word-break: break-word;
}

.quote-box {
  margin: 25px 0 0;
  padding: 18px 17px;
  border-radius: 12px;
  background: linear-gradient(135deg, #f6f2ff, #fff5f0);
}

.quote-label {
  margin-bottom: 7px;
  color: #8c80c9;
  text-align: center;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 3px;
}

.quote {
  margin: 0;
  color: #5c536d;
  text-align: center;
  font-size: 14px;
  line-height: 1.9;
  font-weight: 600;
  overflow-wrap: anywhere;
}

.footer {
  padding: 22px 20px 25px;
  color: #aaa7b4;
  text-align: center;
  font-size: 10px;
  line-height: 1.9;
  letter-spacing: 1px;
}

.footer-line {
  width: 32px;
  height: 2px;
  margin: 0 auto 12px;
  border-radius: 5px;
  background: #d9d5f4;
}

.state {
  padding: 35px 12px;
  color: #8b8799;
  text-align: center;
  font-size: 13px;
  line-height: 1.9;
}

@media (min-width: 600px) {
  .hero { padding: 38px 42px 33px; }
  .main { padding: 29px 42px 0; }
  .news-text { font-size: 16px; }
  .news-item { padding: 16px 0; }
}

@media print {
  html, body { background: white; }
  .poster { max-width: none; box-shadow: none; }
}
</style>
</head>

<body>
<main class="poster">
  <header class="hero">
    <div class="brand">
      <span class="brand-mark">60S · DAILY NEWS</span>
      <span>每日新闻简报</span>
    </div>

    <div class="hero-main">
      <h1 class="weekday" id="weekday">今日简报</h1>
      <div class="hero-bottom">
        <span class="hero-subtitle">每天 60 秒，读懂这个世界</span>
        <span class="date-badge" id="dateBadge">每日更新</span>
      </div>
    </div>
  </header>

  <section class="main">
    <div class="kicker">DAILY BRIEFING</div>
    <h2 class="title">今日简报</h2>
    <div class="subtitle" id="dateLine">正在整理今日新闻</div>

    <div class="divider">TODAY'S NEWS</div>

    <ol class="news" id="news">
      <li class="state">正在生成今日新闻海报…</li>
    </ol>

    <section class="quote-box" id="quoteBox" hidden>
      <div class="quote-label">✦ 每日微语 ✦</div>
      <p class="quote" id="quote"></p>
    </section>
  </section>

  <footer class="footer">
    <div class="footer-line"></div>
    <div>每日60S · 读懂世界</div>
    <div id="footerDate">DAILY NEWS</div>
  </footer>
</main>

<script>
(function () {
  "use strict";

  var API_LIST = [
    "https://60s.viki.moe/v2/60s",
    "https://60s-api.viki.moe/v2/60s"
  ];

  var $ = function (id) {
    return document.getElementById(id);
  };

  function str(value) {
    return value == null ? "" : String(value).trim();
  }

  function getNewsText(item) {
    if (typeof item === "string") return item.trim();
    if (!item || typeof item !== "object") return "";
    return str(item.title || item.content || item.text || item.name);
  }

  function formatDate(date) {
    var match = /^(\d{4})-(\d{2})-(\d{2})$/.exec(date);
    if (!match) return date;
    return match[1] + "年" + Number(match[2]) + "月" +
      Number(match[3]) + "日";
  }

  function getWeekdayName(value) {
    var v = str(value);
    if (!v) return "今日简报";

    if (/星期|周[一二三四五六日天]/.test(v)) {
      return v.replace(/^星期/, "星期");
    }

    var map = {
      Monday: "星期一", Tuesday: "星期二",
      Wednesday: "星期三", Thursday: "星期四",
      Friday: "星期五", Saturday: "星期六",
      Sunday: "星期日"
    };

    return map[v] || v;
  }

  function render(json) {
    var data = json && json.data ? json.data : json;
    if (!data || typeof data !== "object") {
      throw new Error("接口返回的数据格式不正确");
    }

    var items = Array.isArray(data.news) ? data.news : [];
    if (!items.length) {
      throw new Error("接口没有返回新闻列表");
    }

    var date = str(data.date);
    var weekday = getWeekdayName(data.day_of_week);
    var lunar = str(data.lunar_date);

    $("weekday").textContent = weekday;
    $("dateBadge").textContent = date || "每日更新";

    $("dateLine").textContent = [
      formatDate(date),
      lunar
    ].filter(Boolean).join("  ·  ");

    $("footerDate").textContent = date
      ? "DAILY NEWS · " + date
      : "DAILY NEWS";

    var list = $("news");
    list.replaceChildren();

    items.forEach(function (item, index) {
      var title = getNewsText(item);
      if (!title) return;

      var li = document.createElement("li");
      li.className = "news-item";

      var number = document.createElement("span");
      number.className = "number";
      number.textContent = String(index + 1).padStart(2, "0");

      var content = document.createElement("div");
      content.className = "news-content";

      var text = document.createElement("p");
      text.className = "news-text";
      text.textContent = title;

      content.appendChild(text);
      li.appendChild(number);
      li.appendChild(content);
      list.appendChild(li);
    });

    var tip = str(data.tip);
    if (tip) {
      $("quote").textContent = "“" + tip + "”";
      $("quoteBox").hidden = false;
    } else {
      $("quoteBox").hidden = true;
    }

    document.title = "每日60S · " + (date || "今日简报");
  }

  function showError() {
    $("news").innerHTML = "";
    var li = document.createElement("li");
    li.className = "state";
    li.textContent = "今日新闻暂时无法获取，请稍后刷新页面。";
    $("news").appendChild(li);
  }

  function load(index) {
    if (index >= API_LIST.length) {
      showError();
      return;
    }

    fetch(API_LIST[index], { cache: "no-store" })
      .then(function (response) {
        if (!response.ok) {
          throw new Error("HTTP " + response.status);
        }
        return response.json();
      })
      .then(render)
      .catch(function () {
        load(index + 1);
      });
  }

  load(0);
})();
</script>
</body>
</html>
